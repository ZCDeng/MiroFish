# ===== LLM 配置（统一 OpenAI SDK 协议）=====
# 第 1 层：主 LLM。报告 agent / profile 生成 / 模拟配置生成都用它
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_NAME=Pro/deepseek-ai/DeepSeek-V3

# 第 2 层：OASIS 模拟。轮数 × agent 数 = 全链路调用量最大的一段，
# 值得单独指一个便宜的 provider。三项各自回退到第 1 层，只想换小模型就只填 MODEL。
# 注意三项要么都改要么都不改 —— 只换模型名会让模型和 base_url 来自不同 provider。
SIMULATION_AGENT_MODEL=deepseek-v4-flash
SIMULATION_AGENT_API_KEY=your_deepseek_key_here
SIMULATION_AGENT_BASE_URL=https://api.deepseek.com

# 模拟每轮同时在飞的 LLM 请求数。原来写死 3，是 GLM 免费额度时代防 429 定的，
# 换付费 provider 后纯属吞吐瓶颈。实测 SiliconFlow / DeepSeek 各打 12 并发
# 都是全 200 无 429，所以默认 12；撞限流就往下调。
SIMULATION_SEMAPHORE=12
# 每轮结束后给每个 agent 保留多少条对话。0 = 全清（老行为，agent 每轮失忆）。
SIMULATION_AGENT_MEMORY_WINDOW=12

# ===== Flask =====
# 走 app.config.from_object(Config) 进 Flask，用于 session 签名
SECRET_KEY=change-me
# 与 docker-compose.yml 保持一致
FLASK_PORT=5002
FLASK_HOST=0.0.0.0
# 必须保持 False。开着会把 Werkzeug 交互式调试控制台暴露出去，等于远程代码执行
FLASK_DEBUG=False

# ===== Neo4j =====
# 宿主机跑后端用 localhost（compose 已把 7687 映射出来）；
# 在容器里跑时 docker-compose.yml 会覆盖成 bolt://mirofish-neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ===== Graphiti =====
# 第 3 层：图谱抽取主模型。这三项留空会继承第 1 层，
# 但不要写成 ${LLM_API_KEY} —— python-dotenv 会展开，而 docker-compose 的
# env_file 不做插值，容器里会拿到字面量 '${LLM_API_KEY}' 然后认证失败
GRAPHITI_API_KEY=your_api_key_here
GRAPHITI_BASE_URL=https://api.siliconflow.cn/v1
GRAPHITI_MODEL_NAME=Pro/deepseek-ai/DeepSeek-V3
# 第 4 层：小模型，用于低复杂度实体任务
GRAPHITI_SMALL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 结构化输出模式。json_schema 由服务端强制 schema，抽取质量明显更好；
# json_object 只保证是合法 JSON，schema 靠 prompt 提示。
# 留空则按 base_url 自动判断：deepseek/dashscope/bigmodel/zhipu 用 json_object，
# 其余用 json_schema。实测同一份文档，json_schema 下实体带子类型率 66%，
# json_object 下只有 18%，所以图谱抽取这层优先选支持 json_schema 的 provider。
GRAPHITI_STRUCTURED_OUTPUT_MODE=

# chat_json 遇到「推理模型把预算全花在思考上、没输出内容」时翻倍重试的上限。
# 实测 deepseek-v4-flash 做本体生成要 16384 才够。
LLM_MAX_TOKENS_CEILING=16384

# 第 5 层：embedding。缺这三项 build_graphiti_client() 会直接抛，
# 不再静默回落到哈希伪向量（那会让写入向量和检索向量落在两个空间）
GRAPHITI_EMBEDDER_API_KEY=your_api_key_here
GRAPHITI_EMBEDDER_BASE_URL=https://api.siliconflow.cn/v1
# bge-m3 是 1024 维，正好等于 graphiti-core 的 EMBEDDING_DIM 默认值
GRAPHITI_EMBEDDER_MODEL=BAAI/bge-m3

# graphiti-core 0.29 起自带 PostHog 遥测且默认开启，会往 us.i.posthog.com 发数据。
# config.py 里已经默认关掉，这里显式写出来
GRAPHITI_TELEMETRY_ENABLED=false

GRAPHITI_REQUEST_TIMEOUT=180
GRAPHITI_REQUEST_RETRIES=0
GRAPHITI_EPISODE_TIMEOUT=480
# 并发上限。这个 5 是 GLM 免费额度时代定的，换成付费档之后可以往上调，
# 调之前先确认账号的实际 RPM
GRAPHITI_SEMAPHORE_LIMIT=12
GRAPHITI_BUILD_TIMEOUT=540
GRAPHITI_BUILD_TIMEOUT_CAP=7200
GRAPHITI_BATCH_SIZE=1
GRAPHITI_CHUNK_MAX_CHARS=1200
GRAPHITI_MAX_CHUNKS=5
GRAPHITI_ONTOLOGY_CHUNK_THRESHOLD=40
GRAPHITI_MAX_ENTITY_TYPES=6
GRAPHITI_MAX_ENTITY_ATTRIBUTES=3
GRAPHITI_MAX_TOKENS=8192

# 读整张图时的行数上限。graphiti_entity_reader 的几条 Cypher 原来没有 LIMIT，
# 图一大就把全部节点和边 materialize 进内存。命中上限会打 warning 不会静默截断。
GRAPHITI_MAX_GRAPH_ROWS=5000

# 索引没建成时拒绝继续写图。缺全文索引的图谱看着正常，但混合检索的
# BM25 那一半是废的。设成 false 才退回「只打 warning 然后放行」。
GRAPHITI_REQUIRE_INDICES=true
